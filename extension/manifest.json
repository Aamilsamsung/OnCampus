{
  "manifest_version": 3,
  "name": "OnCampus Event Collector",
  "version": "0.4.0",
  "description": "Scan the open approved WhatsApp chat and upload event candidates to OnCampus review",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://oncampus-pesu.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}