{
  "manifest_version": 3,
  "name": "OnCampus Event Collector",
  "version": "0.8.0",
  "description": "Continuous WhatsApp event scanning",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://oncampus-pesu.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}