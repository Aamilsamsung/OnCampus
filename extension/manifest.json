{
  "manifest_version": 3,
  "name": "OnCampus Collector",
  "version": "0.1.0",
  "description": "Opt-in event collection from selected approved college groups (scaffold).",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}